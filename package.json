{
  "name": "math-classroom-kit",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run lessons && vite build",
    "preview": "wrangler dev --ip 127.0.0.1 --port 8787",
    "typecheck": "npm run lessons && tsc --noEmit",
    "test": "npm run lessons && node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && node --test tests/*.test.mjs && vite build",
    "deploy": "npm run build && wrangler deploy --env production",
    "lessons": "node scripts/build-lessons.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/qrcode": "1.5.6",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "wrangler": "4.150.0"
  },
  "dependencies": {
    "katex": "^0.16.22",
    "qrcode": "1.5.4"
  }
}
